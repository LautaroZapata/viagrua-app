# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Opcionales ────────────────────────────────────────────────────────────────
# Todo lo que sigue se puede dejar vacio: sin estas variables la app arranca
# igual y la funcionalidad asociada simplemente no se activa. Es a proposito,
# para que un clon del repo levante sin tener que dar de alta cuentas en
# servicios de terceros.

# reCAPTCHA v3 (https://www.google.com/recaptcha/admin)
# Sin estas dos, verificarRecaptcha() deja pasar todo. Cargarlas en Vercel antes
# de salir a produccion: son las que frenan el alta automatizada de empresas.
# Los dominios del deploy (produccion y los preview de Vercel) tienen que estar
# en la lista de la consola de reCAPTCHA o Google rechaza todos los tokens.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Score minimo para aceptar. Default 0.5, el que recomienda Google. Bajarlo si
# aparecen falsos positivos en el panel de reCAPTCHA.
RECAPTCHA_MIN_SCORE=

# Sentry (https://sentry.io)
# Sin DSN, Sentry no arranca y no pesa nada en runtime. El DSN es publico por
# diseno: identifica el proyecto, no autoriza a leer nada.
NEXT_PUBLIC_SENTRY_DSN=
# Solo para subir source maps en el build, y asi ver stack traces sin minificar.
# Requiere correr `pnpm approve-builds` una vez para habilitar @sentry/cli.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# CSP
# En 1, la Content-Security-Policy estricta del area autenticada pasa de modo
# reporte a bloquear de verdad. Ver la nota en proxy.ts antes de activarla.
CSP_ENFORCE=
